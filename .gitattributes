# Set default behavior to handle line endings automatically.
* text=auto

# Force LF line endings for all text files (standard for web/backend projects)
* text eol=lf

# Explicitly declare file types that are always text and should use LF.
*.cs text eol=lf
*.tsx text eol=lf
*.ts text eol=lf
*.js text eol=lf
*.css text eol=lf
*.html text eol=lf
*.json text eol=lf
*.md text eol=lf
*.sql text eol=lf
*.csproj text eol=lf
*.sln text eol=lf

# Declare files that will always have CRLF (if needed, e.g. for specific Windows tools)
# *.bat text eol=crlf
# *.ps1 text eol=crlf

# Denote all files that are truly binary and should not be modified.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
