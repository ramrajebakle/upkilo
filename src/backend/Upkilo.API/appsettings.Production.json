{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  // *.azurewebsites.net is REQUIRED, not optional. App Service's own warm-up probe and
  // deploy.yml's readiness gate both call https://upkilo-api-prod.azurewebsites.net/ready.
  // Restricting this to upkilo.com alone makes host filtering reject those requests with
  // HTTP 400, so a perfectly healthy container never passes readiness and every deploy
  // fails — while the app itself is fine.
  "AllowedHosts": "*.upkilo.com;upkilo.com;*.azurewebsites.net",
  "Cors": {
    // The apex serves marketing + public booking pages, which call the API directly,
    // so it must be an allowed origin alongside the dashboard subdomain.
    "AllowedOrigins": [ "https://upkilo.com", "https://app.upkilo.com", "https://www.upkilo.com" ]
  },
  "App": {
    "FrontendUrl": "https://app.upkilo.com"
  },
  "Auth": {
    // C-NEW-02 FIX: Strict registration rate limit for production — 5 attempts per IP per hour.
    "RegistrationMaxAttemptsPerHour": 5
  },
  "ConnectionStrings": {
    "DefaultConnection": "${DATABASE_URL};SSL Mode=Require;Trust Server Certificate=false",
    "ReplicaConnection": "${DATABASE_REPLICA_URL};SSL Mode=Require;Trust Server Certificate=false",
    "Redis": "${REDIS_URL}"
  },
  "ReadReplica": {
    "Enabled": true,
    "ReadOperationsThresholdMs": 50
  },
  "Elasticsearch": {
    "Uri": "${ELASTICSEARCH_URL}",
    "Username": "${ELASTICSEARCH_USERNAME}",
    "Password": "${ELASTICSEARCH_PASSWORD}"
  },
  "AzureServiceBus": {
    "ConnectionString": "${AZURE_SERVICE_BUS_CONNECTION_STRING}"
  },
  "Jwt": {
    "Secret": "${JWT_SECRET}",
    "Issuer": "https://api.upkilo.com",
    "Audience": "https://app.upkilo.com",
    "ExpirationMinutes": 30
  },
  "Stripe": {
    "SecretKey": "${STRIPE_SECRET_KEY}",
    "WebhookSecret": "${STRIPE_WEBHOOK_SECRET}",
    "PublishableKey": "${STRIPE_PUBLISHABLE_KEY}"
  },
  "SendGrid": {
    "ApiKey": "${SENDGRID_API_KEY}"
  },
  "Twilio": {
    "AccountSid": "${TWILIO_ACCOUNT_SID}",
    "AuthToken": "${TWILIO_AUTH_TOKEN}",
    "PhoneNumber": "${TWILIO_PHONE_NUMBER}"
  },
  "AzureOpenAI": {
    "Endpoint": "${AZURE_OPENAI_ENDPOINT}",
    "ApiKey": "${AZURE_OPENAI_API_KEY}",
    "DeploymentName": "gpt-4o"
  },
  "AzureStorage": {
    "ConnectionString": "${AZURE_STORAGE_CONNECTION_STRING}"
  },
  "ApplicationInsights": {
    "ConnectionString": "${APPLICATIONINSIGHTS_CONNECTION_STRING}"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Warning",
      "Override": {
        "Microsoft": "Error",
        "System": "Error",
        "Upkilo": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": "Serilog.Formatting.Json.JsonFormatter, Serilog"
        }
      }
    ]
  },
  "Kestrel": {
    "Limits": {
      "MaxRequestBodySize": 52428800,
      "RequestHeadersTimeout": "00:00:30",
      "KeepAliveTimeout": "00:02:00"
    }
  }
}
