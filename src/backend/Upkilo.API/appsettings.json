{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  // CRITICAL-08: Restrict AllowedHosts — never use '*' in base config
  "AllowedHosts": "localhost",
  "Cors": {
    "AllowedOrigins": [ "http://localhost:3000", "https://localhost:3000" ]
  },
  "App": {
    "FrontendUrl": "http://localhost:3000"
  },
  "Auth": {
    // C-NEW-02 FIX: Registration attempts per IP per hour.
    // Dev default: 50. Production overrides to 5 in appsettings.Production.json.
    "RegistrationMaxAttemptsPerHour": 50
  },
  "AzureKeyVault": {
    "VaultUri": ""
  },
  // ─────────────────────────────────────────────────────────────────
  // Development-only defaults — all overridden by Key Vault in prod.
  // DO NOT put real secrets here. Use appsettings.Development.json
  // (gitignored) or Azure Key Vault for real values.
  // ─────────────────────────────────────────────────────────────────
  "ConnectionStrings": {
    "DefaultConnection": "Host=127.0.0.1;Port=6432;Database=upkilo;Username=upkilo;Password=REPLACE_WITH_SECRET_IN_ENV_OR_KEYVAULT;Pooling=true;Maximum Pool Size=100;Minimum Pool Size=20",
    "ReplicaConnection": "Host=127.0.0.1;Port=6432;Database=upkilo;Username=upkilo;Password=REPLACE_WITH_SECRET_IN_ENV_OR_KEYVAULT;Pooling=true;Maximum Pool Size=50;Minimum Pool Size=5;ApplicationName=Upkilo-ReadReplica",
    "Redis": "127.0.0.1:6379,abortConnect=false"
  },
  "ReadReplica": {
    "Enabled": true,
    "ReadOperationsThresholdMs": 50
  },
  "Elasticsearch": {
    "Uri": "http://localhost:9200"
  },
  "AzureServiceBus": {
    "ConnectionString": ""
  },
  "Jwt": {
    "Secret": "",
    "Issuer": "https://api.upkilo.com",
    "Audience": "https://upkilo.com",
    "ExpirationMinutes": 60
  },
  "Stripe": {
    "SecretKey": "",
    "WebhookSecret": "",
    "PublishableKey": ""
  },
  "SendGrid": {
    "ApiKey": ""
  },
  "Twilio": {
    "AccountSid": "",
    "AuthToken": "",
    "PhoneNumber": "+10000000000"
  },
  "AzureOpenAI": {
    "Endpoint": "https://YOUR_RESOURCE.openai.azure.com",
    "ApiKey": "",
    "DeploymentName": "gpt-4o",
    "PricingInput": {
      "gpt-4": "0.000001",
      "gpt-4o": "0.0000025",
      "gpt-35-turbo": "0.0000005"
    },
    "PricingOutput": {
      "gpt-4": "0.000003",
      "gpt-4o": "0.000010",
      "gpt-35-turbo": "0.0000015"
    }
  },
  "AzureStorage": {
    "ConnectionString": ""
  },
  "PagerDuty": {
    "IntegrationKey": ""
  },
  // Memory limits are measured against the process WORKING SET, which for a .NET 8 host
  // includes the uncollected GC heap and normally sits well above 512 MB for this app
  // (EF Core + Hangfire + Redis + SignalR). The previous 512/768 values were below the
  // app's idle footprint, so IsSystemDegraded() was permanently true and every
  // [AllowGracefulDegradation] endpoint — the whole DashboardController — returned 503
  // during normal operation. These values leave real headroom while still shedding load
  // under genuine pressure.
  "SystemLoadMonitor": {
    "DegradedThreshold": 1000,
    "OverloadedThreshold": 5000,
    "MemoryDegradedMb": 2048,
    "MemoryOverloadedMb": 3072
  },
  "Jaeger": {
    "OtlpEndpoint": "http://localhost:4317"
  },
  "DataWarehouse": {
    "Target": "BigQuery",
    "BigQuery": {
      "ProjectId": "",
      "DatasetId": "upkilo_dw",
      "ServiceAccountJson": ""
    }
  },
  "Integrations": {
    "QuickBooks": {
      "ClientId": "",
      "ClientSecret": "",
      "RedirectUri": "https://app.upkilo.com/auth/quickbooks/callback"
    },
    "Xero": {
      "ClientId": "",
      "ClientSecret": ""
    },
    "Klaviyo": { "ApiKey": "" },
    "Mailchimp": { "ApiKey": "" }
  },
  "LaunchDarkly": {
    "SdkKey": "",
    "ProjectKey": "upkilo",
    "EnvironmentKey": "production"
  },
  "Azure": {
    "SubscriptionId": "",
    "ResourceGroup": "upkilo-prod-rg",
    "AppServiceName": "upkilo-prod-api",
    "Location": "eastus"
  },
  "CampaignTracking": {
    // VULN-A08: Must be overridden in production via Key Vault / env var.
    // Generate: openssl rand -base64 32
    // App throws InvalidOperationException at startup if this key is absent.
    "TokenSecret": ""
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {CorrelationId} {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  }
}
