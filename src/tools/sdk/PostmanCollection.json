{
	"info": {
		"_postman_id": "upkilo-api-v1",
		"name": "Upkilo API v1 Official Reference",
		"description": "Comprehensive Postman collection for the Upkilo SaaS platform, including Sandbox and Webhook testing.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Bookings",
			"item": [
				{
					"name": "List Bookings",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/bookings",
							"host": ["{{baseUrl}}"],
							"path": ["bookings"]
						}
					}
				},
				{
					"name": "Create Event",
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"serviceId\": \"{{serviceId}}\",\n  \"startTime\": \"{{startTime}}\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/bookings",
							"host": ["{{baseUrl}}"],
							"path": ["bookings"]
						}
					}
				}
			]
		},
		{
			"name": "Sandbox",
			"item": [
				{
					"name": "Provision Sandbox",
					"request": {
						"method": "POST",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/sandbox",
							"host": ["{{baseUrl}}"],
							"path": ["sandbox"]
						}
					}
				}
			]
		}
	],
	"auth": {
		"type": "bearer",
		"bearer": [
			{
				"key": "token",
				"value": "{{apiKey}}",
				"type": "string"
			}
		]
	},
	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"exec": [
					""
				]
			}
		}
	],
	"variable": [
		{
			"key": "baseUrl",
			"value": "https://api.upkilo.com/api/v1",
			"type": "string"
		},
		{
			"key": "apiKey",
			"value": "YOUR_API_KEY",
			"type": "string"
		}
	]
}
