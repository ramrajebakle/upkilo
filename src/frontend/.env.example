# Upkilo Frontend — Environment Variables
# Copy this file to .env.local for local development.
# Production values are injected by Azure App Service (Bicep / Key Vault references).
# NEVER commit real secrets to version control.

# ─── Public (safe for browser) ────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:5000
NEXT_PUBLIC_SIGNALR_URL=http://localhost:5000/hubs/notifications
NEXT_PUBLIC_APP_NAME=Upkilo
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe publishable key (safe — client-side only, never the secret key)
NEXT_PUBLIC_STRIPE_KEY=pk_test_REPLACE_WITH_YOUR_STRIPE_PUBLISHABLE_KEY

# ─── Private (server-side only — NEVER expose to browser) ─────────────────────

# REQUIRED IN PRODUCTION. NextAuth v5 encrypts the session JWE with this key.
# middleware.ts wraps every route in auth(), so without it NextAuth throws MissingSecret
# on EVERY request — including the login page. NextAuth tolerates its absence in
# development only, so a missing value shows up for the first time in production.
# Generate with: openssl rand -base64 48
AUTH_SECRET=
# Set to true when running behind a proxy/load balancer (Azure App Service, Front Door).
AUTH_TRUST_HOST=true

# NOTE: JWT_SECRET below is NO LONGER read by middleware.ts — that file now delegates to
# NextAuth's auth() helper, which uses AUTH_SECRET above. This var is retained only for
# any server-side route that still verifies backend-issued tokens directly.
# Minimum 32 characters. Generate with: openssl rand -base64 48
JWT_SECRET=dev-only-jwt-secret-min-32-chars-DO-NOT-USE-IN-PRODUCTION-REPLACE-ME

# Google OAuth2 (for social login)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-REPLACE_WITH_GOOGLE_SECRET

# Apple Sign-In
APPLE_CLIENT_ID=com.upkilo.app
APPLE_TEAM_ID=REPLACE_TEAM_ID
APPLE_KEY_ID=REPLACE_KEY_ID
APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_WITH_APPLE_PRIVATE_KEY\n-----END PRIVATE KEY-----"
