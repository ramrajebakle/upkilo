# ================================================================
# Upkilo — Environment Variable Reference
# Copy to .env for local development. NEVER commit .env.
# All production values must live in Azure Key Vault.
# ================================================================

# ── Database ─────────────────────────────────────────────────────
DATABASE_URL=postgres://upkilo:upkilo_dev_2026@localhost:5432/upkilo
DATABASE_REPLICA_URL=postgres://upkilo:upkilo_dev_2026@localhost:5432/upkilo

# ── Cache ────────────────────────────────────────────────────────
REDIS_URL=localhost:6379

# ── Auth (NEVER use this value in production — use Key Vault) ────
JWT_SECRET=dev-only-jwt-secret-min-32-chars-replace-in-keyvault
JWT_ISSUER=https://api.upkilo.com
JWT_AUDIENCE=https://upkilo.com
JWT_EXPIRY_MINUTES=60

# ── Frontend (prefix NEXT_PUBLIC_ for browser-visible values) ────
NEXT_PUBLIC_API_URL=http://localhost:5000
NEXT_PUBLIC_SIGNALR_URL=http://localhost:5000/hubs/notifications
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Upkilo
JWT_SECRET=dev-only-jwt-secret-min-32-chars-replace-in-keyvault

# ── Stripe (use test keys locally) ───────────────────────────────
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# ── SendGrid ─────────────────────────────────────────────────────
SENDGRID_API_KEY=SG.xxx

# ── Twilio ───────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxx
TWILIO_AUTH_TOKEN=xxx
TWILIO_PHONE_NUMBER=+1xxx

# ── Azure OpenAI ─────────────────────────────────────────────────
# NOTE the DOUBLE underscore. .NET maps "__" to the ":" config separator, so
# AzureOpenAI__ApiKey binds to AzureOpenAI:ApiKey — which is what the code reads
# (AzureOpenAIService). The single-underscore AZURE_OPENAI_API_KEY spelling that used to be
# here binds to a key nothing reads, so AI silently stayed unconfigured locally and every
# generation returned "AI not configured". CI/production already use the "__" form
# (see .github/workflows/deploy.yml).
AzureOpenAI__Endpoint=https://xxx.openai.azure.com
AzureOpenAI__ApiKey=xxx
# Must match a real deployment name in the Azure OpenAI resource, and must also appear in
# AiModelResolver + AzureOpenAIService.IsModelAllowedAsync or the call is rejected before dispatch.
AzureOpenAI__DeploymentName=gpt-5-mini

# Monthly USD cap for the anonymous Upkilo support bot on the marketing site. Optional —
# defaults to 25.00. Set to 0 to disable that bot.
Ai__PlatformMonthlyBudget=25.00

# Bills AI overage to Stripe for plans with StripeAiUsagePriceId set. OFF by default —
# enabling it charges real money. It is NOT what protects Upkilo's Azure bill: the per-tenant
# AiMonthlyBudget cap already blocks overspend on every call, with or without this.
Billing__ReportAiUsage=false

# ── Azure Storage ─────────────────────────────────────────────────
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;...

# ── Azure Service Bus (replaces RabbitMQ) ────────────────────────
# Leave empty in local dev — app falls back to in-memory transport
AZURE_SERVICE_BUS_CONNECTION_STRING=

# ── Elasticsearch ─────────────────────────────────────────────────
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=

# ── Application Insights ─────────────────────────────────────────
APPLICATIONINSIGHTS_CONNECTION_STRING=

# ── Application ──────────────────────────────────────────────────
ASPNETCORE_ENVIRONMENT=Development

# ── Optional Integrations ─────────────────────────────────────────
LAUNCHDARKLY_SDK_KEY=
PAGERDUTY_INTEGRATION_KEY=
