# .gitignore for Upkilo Project

# ================================================================
# SECURITY: Never commit secrets or credentials
# ================================================================

# Environment files — use .env.example as the template
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
src/frontend/.env.local

# Backend — local / Development overrides contain real secrets
src/backend/Upkilo.API/appsettings.Development.json
src/backend/Upkilo.API/appsettings.Local.json

# Azure publish profiles contain deployment credentials
*.PublishSettings
*.publishsettings

# Migration SQL scripts may contain connection-string fragments
migration-*.sql

# ================================================================
# IDE & System
# ================================================================
.vs/
.vscode/
# Local Claude Code tooling state (skills, settings) — not part of the app.
.claude/
*.user
*.userosscache
*.sln.docstates
.idea/
.DS_Store
Thumbs.db
graphify-out/

# ================================================================
# .NET / Backend
# ================================================================
bin/
obj/
publish/
*.log
*.txt
!api_errors_final.txt
!api_errors_final_utf8.txt
# public/ holds web-served assets, not build output. The blanket *.txt above silently
# excluded llms.txt — a file whose entire purpose is to be fetched from the deployed site,
# so being ignored made it useless. Any future .txt served from public/ (ads.txt,
# security.txt, a static robots.txt) would have been dropped the same way, without error.
!src/frontend/public/*.txt

# ================================================================
# Node.js / Frontend
# ================================================================
node_modules/
.next/
out/
build/
dist/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ================================================================
# Databases
# ================================================================
*.db
*.sqlite

# ================================================================
# Terraform / Infrastructure state
# ================================================================
.terraform/
*.tfstate
*.tfstate.backup

# ================================================================
# Temporary Files
# ================================================================
tmp/
temp/

# Vendored k6 binary (auto-downloaded by run-all.ps1 if missing)
infrastructure/load-testing/.tools/
